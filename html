<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Happy Birthday Fatema 🎂</title>

    <link rel="stylesheet" href="style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;500;600;700&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>

    <!-- Animated Background -->
    <div class="background">
        <div class="blob blob1"></div>
        <div class="blob blob2"></div>
        <div class="blob blob3"></div>
    </div>

    <!-- DATE LOGIN -->
    <section id="loginScreen" class="login-screen">

        <div class="login-card glass">

            <div class="lock">🔐</div>

            <h1>A Little Surprise</h1>

            <p class="login-subtitle">
                There is something special waiting for Fatema...
            </p>

            <p class="small-text">
                Enter the special date to unlock it 💗
            </p>

            <input
                type="date"
                id="dateInput"
                class="date-input"
            >

            <button id="unlockBtn" class="main-btn">
                Unlock the Surprise ✨
            </button>

            <p id="errorMessage" class="error"></p>

        </div>

    </section>


    <!-- MAIN WEBSITE -->
    <main id="birthdayWebsite" class="hidden">

        <!-- HERO -->
        <section class="hero section">

            <div class="glass hero-card">

                <div class="sparkle">✨ 🎀 ✨</div>

                <p class="tiny-title">
                    TODAY IS YOUR SPECIAL DAY
                </p>

                <h1>
                    Happy Birthday
                    <span>Fatema</span> 🎂
                </h1>

                <p class="hero-text">
                    Today isn't just another day.
                    Today is the day the world got a little brighter
                    because you were born. 💗
                </p>

                <button class="scroll-btn" onclick="scrollToSection('wishes')">
                    Open Your Wishes ↓
                </button>

            </div>

        </section>


        <!-- WISH SECTION -->
        <section id="wishes" class="section">

            <div class="section-title">
                <p>FROM THE HEART 💌</p>
                <h2>Birthday Wishes For Fatema</h2>
            </div>

            <div class="cards">

                <div class="glass wish-card">
                    <span>🌸</span>
                    <h3>Happiness</h3>
                    <p>
                        May your life always be filled with beautiful
                        moments, genuine smiles and countless reasons
                        to be happy.
                    </p>
                </div>

                <div class="glass wish-card">
                    <span>✨</span>
                    <h3>Dreams</h3>
                    <p>
                        May every dream you secretly carry in your heart
                        slowly turn into a beautiful reality.
                    </p>
                </div>

                <div class="glass wish-card">
                    <span>🌷</span>
                    <h3>Peace</h3>
                    <p>
                        May you always find peace in your heart,
                        even when life gets a little difficult.
                    </p>
                </div>

                <div class="glass wish-card">
                    <span>💫</span>
                    <h3>Success</h3>
                    <p>
                        May every step you take bring you closer to
                        the future you have always imagined.
                    </p>
                </div>

                <div class="glass wish-card">
                    <span>🦋</span>
                    <h3>Beautiful Moments</h3>
                    <p>
                        May this year bring unexpected happiness,
                        unforgettable memories and wonderful surprises.
                    </p>
                </div>

                <div class="glass wish-card">
                    <span>💗</span>
                    <h3>Love & Care</h3>
                    <p>
                        May you always be surrounded by people who
                        genuinely care about you and appreciate you.
                    </p>
                </div>

            </div>

        </section>


        <!-- SPECIAL MESSAGE -->
        <section class="section">

            <div class="glass message-card">

                <div class="message-icon">💌</div>

                <p class="tiny-title">
                    A LITTLE MESSAGE
                </p>

                <h2>Dear Fatema...</h2>

                <p>
                    On your birthday, I just want to wish you something
                    more than a simple "Happy Birthday".
                </p>

                <p>
                    I hope the coming days bring you the kind of happiness
                    that doesn't need a reason.
                </p>

                <p>
                    I hope you laugh more, worry less, dream bigger,
                    and never forget how special you are.
                </p>

                <p>
                    Whatever happens in the future, I hope you always
                    keep that beautiful light inside you alive.
                </p>

                <p>
                    May this new chapter of your life be softer,
                    brighter, happier and full of beautiful surprises. 🌸
                </p>

            </div>

        </section>


        <!-- BIRTHDAY PROMISES -->
        <section class="section">

            <div class="section-title">
                <p>THIS YEAR ✨</p>
                <h2>My Birthday Wishes For You</h2>
            </div>

            <div class="promise-grid">

                <div class="glass promise">
                    <strong>01</strong>
                    <p>More reasons to smile 😊</p>
                </div>

                <div class="glass promise">
                    <strong>02</strong>
                    <p>More beautiful memories 📸</p>
                </div>

                <div class="glass promise">
                    <strong>03</strong>
                    <p>More peaceful days 🌿</p>
                </div>

                <div class="glass promise">
                    <strong>04</strong>
                    <p>More success 🌟</p>
                </div>

                <div class="glass promise">
                    <strong>05</strong>
                    <p>More adventures 🦋</p>
                </div>

                <div class="glass promise">
                    <strong>06</strong>
                    <p>More happiness 💗</p>
                </div>

            </div>

        </section>


        <!-- MINI LETTER -->
        <section class="section">

            <div class="glass letter">

                <div class="letter-top">
                    <span>💗</span>
                    <span>💗</span>
                    <span>💗</span>
                </div>

                <h2>A Letter For Fatema</h2>

                <p>
                    Dear Fatema,
                </p>

                <p>
                    Another year of your life has arrived,
                    and I hope this year becomes one of those chapters
                    that you will remember with a smile.
                </p>

                <p>
                    Life won't always be perfect.
                    There will be difficult days,
                    confusing moments and unexpected turns.
                </p>

                <p>
                    But I hope you always remember that difficult days
                    don't define your entire story.
                </p>

                <p>
                    Keep going.
                    Keep dreaming.
                    Keep becoming the person you want to be.
                </p>

                <p>
                    And most importantly...
                    don't forget to enjoy the little things along the way. 🌷
                </p>

                <p class="signature">
                    Happy Birthday, Fatema. 🎂
                </p>

            </div>

        </section>


        <!-- BIRTHDAY COUNT -->
        <section class="section">

            <div class="glass celebration">

                <div class="big-emoji">🎂</div>

                <h2>
                    It's Your Day!
                </h2>

                <p>
                    So forget the worries for a while.
                    Smile a little more.
                    Enjoy the moment.
                </p>

                <div class="counter">

                    <div>
                        <strong id="days">00</strong>
                        <span>Days</span>
                    </div>

                    <div>
                        <strong id="hours">00</strong>
                        <span>Hours</span>
                    </div>

                    <div>
                        <strong id="minutes">00</strong>
                        <span>Minutes</span>
                    </div>

                    <div>
                        <strong id="seconds">00</strong>
                        <span>Seconds</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- FINAL -->
        <section class="section final-section">

            <div class="glass final-card">

                <div class="fireworks">✨ 🎆 ✨</div>

                <h1>
                    Happy Birthday,
                    <span>Fatema</span>! 🎂💗
                </h1>

                <p>
                    May your smile stay bright,
                    your heart stay kind,
                    your dreams stay big,
                    and your days become more beautiful
                    than you imagined.
                </p>

                <p class="final-wish">
                    May this be the beginning of your
                    happiest chapter yet. 🌸
                </p>

                <button
                    class="main-btn"
                    onclick="celebrate()"
                >
                    One More Surprise 🎁
                </button>

                <div id="surprise" class="surprise hidden">
                    <h2>🎉 SURPRISE! 🎉</h2>
                    <p>
                        You deserve all the happiness,
                        love, success and beautiful moments
                        this world has to offer. 💗
                    </p>
                </div>

            </div>

        </section>


        <footer>
            Made with 💗 specially for Fatema
        </footer>

    </main>


    <script src="main.js"></script>

</body>
</html>
